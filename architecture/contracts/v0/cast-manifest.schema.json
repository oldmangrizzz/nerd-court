{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nerdcourt:contracts:v0:cast-manifest",
  "title": "CastManifest (PROPOSED DRAFT)",
  "description": "Episode-wide immutable selection of performer identities, fictional variants, bounded echoes, voice/visual specifications and cited evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "grievance_id",
    "cast_revision",
    "cast",
    "evidence_ledger_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "grievance_id": {
      "type": "string",
      "minLength": 1
    },
    "cast_revision": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ledger_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "production_mode": {
      "enum": [
        "prototype",
        "production"
      ]
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cast_member_id",
          "entity_id",
          "episode_echo_id",
          "role",
          "profile_revision",
          "voice_spec_id",
          "visual_spec_id"
        ],
        "properties": {
          "cast_member_id": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "episode_echo_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "judge",
              "prosecution",
              "defense",
              "announcer",
              "plaintiff",
              "defendant",
              "witness",
              "guest",
              "ensemble"
            ]
          },
          "profile_revision": {
            "type": "string",
            "minLength": 1
          },
          "voice_spec_id": {
            "type": "string",
            "minLength": 1
          },
          "visual_spec_id": {
            "type": "string",
            "minLength": 1
          },
          "source_claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "cast_integrity_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "approved_for_performance": {
      "type": "boolean",
      "default": false
    },
    "approved_for_distribution": {
      "type": "boolean",
      "default": false
    }
  }
}